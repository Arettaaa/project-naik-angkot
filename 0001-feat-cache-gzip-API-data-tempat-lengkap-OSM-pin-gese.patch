+            $res = Http::timeout(5)->withHeaders(['User-Agent' => self::UA, 'Accept-Language' => 'id'])
+                ->get('https://nominatim.openstreetmap.org/reverse', ['lat' => $lat, 'lon' => $lng, 'format' => 'jsonv2', 'zoom' => 18, 'addressdetails' => 1]);
