+                'kel' => $a['village'] ?? ($a['suburb'] ?? ($a['quarter'] ?? ($a['neighbourhood'] ?? ($a['hamlet'] ?? null)))),
+                'kec' => $a['city_district'] ?? ($a['district'] ?? null),
+                'kota' => $a['city'] ?? ($a['town'] ?? ($a['county'] ?? null)),
+            ];
+        } catch (\Throwable $e) {
+            Log::warning('Nominatim reverse: ' . $e->getMessage());
+            return null;
