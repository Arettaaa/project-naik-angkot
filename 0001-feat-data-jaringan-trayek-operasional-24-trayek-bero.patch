+                              nama_trayek=nama_sk[k], nomor_lama=r["nama_lama"], nama_trayek_lama=r["nama_lama_trayek"],
+                              kode_moovit=MOOVIT.get(k, ""), status="beroperasi (jurnal 2021)",
