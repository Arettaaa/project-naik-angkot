+    print(f"(rencana SK: " + ", ".join(f"{k} {rencana[k]:.1f} km" for k in ("rendah", "sedang", "tinggi")) + ")")
+    for r in sorted(laporan, key=lambda r: (r["jenis"], r["kode"])):
